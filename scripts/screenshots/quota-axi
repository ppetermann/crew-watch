#!/usr/bin/env python3
"""Fake `quota-axi --json` for the README screenshots: fixed percentages with
reset times relative to now, in quota-axi's schema-3 shape (see src/quota.rs)."""

import json
from datetime import datetime, timedelta, timezone

now = datetime.now(timezone.utc)


def window(wid, label, kind, used, resets_in):
    # A little slack so the shown countdown does not tick down a unit at once.
    at = now + resets_in + timedelta(seconds=40)
    return {"id": wid, "label": label, "kind": kind, "percentUsed": used,
            "resetsAt": at.isoformat()}


H = timedelta(hours=1)
M = timedelta(minutes=1)
D = timedelta(days=1)
providers = [
    {"provider": "claude", "windows": [
        window("five_hour", "session", "session", 34, 2 * H + 24 * M),
        window("seven_day", "week", "weekly", 61, 3 * D + 7 * H),
        window("model:fable", "Fable week", "model", 22, 3 * D + 7 * H),
    ], "state": {"status": "fresh", "stale": False}},
    {"provider": "zai", "windows": [
        window("five_hour", "session", "session", 78, 1 * H + 11 * M),
        window("seven_day", "week", "weekly", 40, 4 * D + 14 * H),
    ], "state": {"status": "fresh", "stale": False}},
]
print(json.dumps({"generatedAt": now.isoformat(), "schemaVersion": 3,
                  "providers": providers}))
